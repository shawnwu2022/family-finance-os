{$EBK_DOMAIN} {
    tls internal
    encode zstd gzip
    reverse_proxy ezbookkeeping:8080
}

{$FINANCE_DOMAIN} {
    tls internal
    encode zstd gzip

    header {
        X-Frame-Options "DENY"
        Content-Security-Policy "frame-ancestors 'none'"
    }

    @mcp path /mcp
    handle @mcp {
        reverse_proxy finance-core:8000
    }

    handle {
        reverse_proxy finance-core:8000
    }
}
