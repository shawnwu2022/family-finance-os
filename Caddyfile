{$EBK_DOMAIN} {
    encode zstd gzip
    reverse_proxy ezbookkeeping:8080
}

{$FINANCE_DOMAIN} {
    encode zstd gzip

    @mcp path /mcp
    handle @mcp {
        reverse_proxy finance-core:8000
    }

    handle {
        basic_auth {
            {$FINANCE_AUTH_USER} {$FINANCE_AUTH_HASH}
        }
        reverse_proxy finance-core:8000
    }
}
