FROM postgres:18.6-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2
USER root
RUN apk upgrade --no-cache \
 && apk add --no-cache su-exec \
 && for script in /usr/local/bin/docker-entrypoint.sh /usr/local/bin/docker-ensure-initdb.sh /usr/local/bin/docker-enforce-initdb.sh; do \
      if [ -e "$script" ]; then \
        sed -i 's/exec gosu postgres/exec su-exec postgres/g' "$script"; \
      fi; \
    done \
 && ! grep -R 'exec gosu postgres' /usr/local/bin/docker-*.sh \
 && rm -f /usr/local/bin/gosu \
 && su-exec nobody true
