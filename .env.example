# Domains
EBK_DOMAIN=book.example.com
FINANCE_DOMAIN=finance.example.com

# PostgreSQL bootstrap administrator (used only by PostgreSQL container / backups)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_ADMIN_PASSWORD
POSTGRES_DB=postgres

# Finance Core database role
FINANCE_DB_NAME=finance
FINANCE_DB_USER=finance_app
FINANCE_DB_PASSWORD=REPLACE_WITH_FINANCE_DB_PASSWORD

# ezBookkeeping database role
EBK_DB_NAME=ezbookkeeping
EBK_DB_USER=ezbookkeeping_app
EBK_DB_PASSWORD=REPLACE_WITH_EBK_DB_PASSWORD

# ezBookkeeping
EBK_SECURITY_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
# Generate this after first ezBookkeeping login and enabling API tokens.
EBK_API_TOKEN=

# Finance Core
DB_HOST=postgres
DB_PORT=5432
APP_TIMEZONE=Asia/Shanghai
EBK_BASE_URL=http://ezbookkeeping:8080/api/v1

# LLM: point to an OpenAI-compatible model gateway/provider.
# Model IDs are deliberately not hard-coded; validate current candidates with the project eval before changing production.
LLM_BASE_URL=https://llm-gateway.example.com/v1
LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY
LLM_FAST_MODEL=REPLACE_WITH_CURRENT_FAST_MODEL_ID
LLM_PLANNER_MODEL=REPLACE_WITH_CURRENT_PLANNER_MODEL_ID
LLM_REVIEWER_MODEL=REPLACE_WITH_CURRENT_REVIEWER_MODEL_ID

# Optional offsite backup target over SSH/rsync, e.g. backup@home-server:/srv/backups/family-finance-os
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=7
