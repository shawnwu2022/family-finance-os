# Domains
EBK_DOMAIN=book.example.com
FINANCE_DOMAIN=finance.example.com

# Temporary Finance edge authentication used only during the migration cutover.
# Application-native Finance authentication becomes authoritative before these are removed in Task 6.
FINANCE_AUTH_USER=finance
# Generate interactively without putting the plaintext password in shell history:
# docker run --rm -it caddy:2.11.4-alpine caddy hash-password --algorithm bcrypt
# Keep the hash single-quoted in .env because bcrypt hashes contain '$'.
FINANCE_AUTH_HASH='REPLACE_WITH_FINANCE_AUTH_BCRYPT_HASH'

# PostgreSQL bootstrap administrator (used only by PostgreSQL container / backups)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_ADMIN_PASSWORD
POSTGRES_DB=postgres

# Finance Core database role
FINANCE_DB_NAME=finance
FINANCE_DB_USER=finance_app
FINANCE_DB_PASSWORD=REPLACE_WITH_FINANCE_DB_PASSWORD

# ezBookkeeping database role
EBK_DB_NAME=ezbookkeeping
EBK_DB_USER=ezbookkeeping_app
EBK_DB_PASSWORD=REPLACE_WITH_EBK_DB_PASSWORD

# ezBookkeeping
EBK_SECURITY_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
# Set to false after creating the initial account to disable public registration.
EBK_USER_ENABLE_REGISTER=true
# Generate this after first ezBookkeeping login and enabling API tokens.
EBK_API_TOKEN=

# Finance Core
FINANCE_LISTEN_ADDR=:8000
FINANCE_HEALTHCHECK_URL=http://127.0.0.1:8000/healthz
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
APP_TIMEZONE=Asia/Shanghai
EBK_BASE_URL=http://ezbookkeeping:8080/api/v1
# Explicit portfolio values older than 30 days, or FX evidence older than 72 hours,
# remain included but downgrade allocation quality to stale.
PORTFOLIO_VALUATION_STALE_AFTER=720h
PORTFOLIO_FX_STALE_AFTER=72h

# Finance Core application-native authentication.
# These are paths/usernames only; plaintext auth secrets must live in protected files under /run/secrets.
FINANCE_ADMIN_USERNAME=finance
FINANCE_ADMIN_PASSWORD_FILE=/run/secrets/finance-admin-password
FINANCE_AUTH_KEY_FILE=/run/secrets/finance-auth-key

# The Compose bootstrap job is idempotent and gates finance-core startup.
FINANCE_BOOTSTRAP_NAME=家庭
FINANCE_BOOTSTRAP_CURRENCY=CNY
FINANCE_BOOTSTRAP_TIMEZONE=Asia/Shanghai
FINANCE_BOOTSTRAP_LIQUIDITY_FLOOR_MINOR=500000

# MCP is disabled by default. When enabled, the bearer token is read from the file path below;
# never put the token itself in .env or Git.
MCP_ENABLED=false
MCP_TOKEN_FILE=/run/secrets/finance-mcp-token
MCP_HOUSEHOLD_ID=
MCP_ALLOWED_ORIGINS=
MCP_REQUEST_TIMEOUT=15s
MCP_MAX_CONCURRENT=4
MCP_REQUESTS_PER_MINUTE=60
MCP_MAX_BODY_BYTES=262144

# LLM: point to an OpenAI-compatible model gateway/provider.
# Model IDs are deliberately not hard-coded; validate current candidates with the project eval before changing production.
LLM_BASE_URL=https://llm-gateway.example.com/v1
LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY
LLM_FAST_MODEL=REPLACE_WITH_CURRENT_FAST_MODEL_ID
LLM_PLANNER_MODEL=REPLACE_WITH_CURRENT_PLANNER_MODEL_ID
LLM_REVIEWER_MODEL=REPLACE_WITH_CURRENT_REVIEWER_MODEL_ID

# Optional encrypted off-site backup. Leave these blank during initial application bootstrap.
# Before production acceptance, configure a restic REST backend over HTTPS against a
# rest-server endpoint that is authenticated and append-only for this producer identity.
# Example with rest-server --private-repos:
# RESTIC_REPOSITORY=rest:https://backup.example.com/family-finance-prod/
# RESTIC_REST_USERNAME=family-finance-prod
RESTIC_REPOSITORY=
# Restic repository encryption password. Absolute path outside this repository.
RESTIC_PASSWORD_FILE=
# Producer identity for the append-only REST endpoint. Not a secret by itself.
RESTIC_REST_USERNAME=
# Family Finance OS wrapper variable. Absolute private file outside this repository;
# backup.sh reads it and passes native RESTIC_REST_PASSWORD only to restic child processes.
RESTIC_REST_PASSWORD_FILE=
# Local staging backups are retained independently from off-site maintenance retention.
BACKUP_RETENTION_DAYS=14
