# Public hostnames
FINANCE_HOST=finance.example.com
BOOK_HOST=book.example.com

# PostgreSQL bootstrap admin
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-me

# Finance Core database
FINANCE_DB_NAME=finance
FINANCE_DB_USER=finance_app
FINANCE_DB_PASSWORD=replace-me

# ezBookkeeping database
EBK_DB_NAME=ezbookkeeping
EBK_DB_USER=ezbookkeeping_app
EBK_DB_PASSWORD=replace-me

# ezBookkeeping
EBK_SECRET_KEY=replace-me
EBK_ENABLE_API_TOKEN=true
EBK_API_TOKEN=

# Finance Core
FINANCE_LISTEN_ADDR=:8000
FINANCE_HEALTHCHECK_URL=http://127.0.0.1:8000/healthz
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
APP_TIMEZONE=Asia/Shanghai
EBK_BASE_URL=http://ezbookkeeping:8080/api/v1

# LLM (OpenAI-compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_FAST_MODEL=
LLM_PLANNER_MODEL=
LLM_REVIEWER_MODEL=

# Backup
BACKUP_DIR=./backups
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
