# Domains
EBK_DOMAIN=book.example.com
FINANCE_DOMAIN=finance.example.com

# PostgreSQL bootstrap administrator (used only by PostgreSQL container / backups)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_ADMIN_PASSWORD
POSTGRES_DB=postgres

# Finance Core database role
FINANCE_DB_NAME=finance
FINANCE_DB_USER=finance_app
FINANCE_DB_PASSWORD=REPLACE_WITH_FINANCE_DB_PASSWORD

# ezBookkeeping database role
EBK_DB_NAME=ezbookkeeping
EBK_DB_USER=ezbookkeeping_app
EBK_DB_PASSWORD=REPLACE_WITH_EBK_DB_PASSWORD

# External secret files. These files must live outside the repository, use mode 0600,
# and be owned by the UID of the container that reads them (Finance: 65532, ezBookkeeping: 1000).
FINANCE_AUTH_KEY_HOST_FILE=/etc/family-finance/secrets/finance-auth-key
FINANCE_ADMIN_PASSWORD_HOST_FILE=/etc/family-finance/secrets/finance-admin-password
EBK_API_TOKEN_HOST_FILE=/etc/family-finance/secrets/ezbookkeeping-api-token
EBK_SECURITY_SECRET_KEY_HOST_FILE=/etc/family-finance/secrets/ezbookkeeping-secret-key
# Only required when MCP_ENABLED=true. When disabled, Compose mounts /dev/null instead.
MCP_TOKEN_HOST_FILE=

# ezBookkeeping registration is closed by default. Use a one-time explicit override only
# while creating the first owner account; production preflight rejects true.
EBK_USER_ENABLE_REGISTER=false

# Finance Core
FINANCE_LISTEN_ADDR=:8000
FINANCE_HEALTHCHECK_URL=http://127.0.0.1:8000/healthz
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
APP_TIMEZONE=Asia/Shanghai
EBK_BASE_URL=http://ezbookkeeping:8080/api/v1
EBK_API_TOKEN_FILE=/run/secrets/ezbookkeeping-api-token
PORTFOLIO_VALUATION_STALE_AFTER=720h
PORTFOLIO_FX_STALE_AFTER=72h

# Finance Core application-native authentication. These are non-secret identity/path settings.
FINANCE_ADMIN_USERNAME=finance
FINANCE_ADMIN_PASSWORD_FILE=/run/secrets/finance-admin-password
FINANCE_AUTH_KEY_FILE=/run/secrets/finance-auth-key

# The Compose bootstrap job is idempotent and gates finance-core startup.
FINANCE_BOOTSTRAP_NAME=家庭
FINANCE_BOOTSTRAP_CURRENCY=CNY
FINANCE_BOOTSTRAP_TIMEZONE=Asia/Shanghai
FINANCE_BOOTSTRAP_LIQUIDITY_FLOOR_MINOR=500000

# MCP is disabled by default. When enabled, its bearer token is read from MCP_TOKEN_HOST_FILE.
MCP_ENABLED=false
MCP_TOKEN_FILE=/run/secrets/finance-mcp-token
MCP_HOUSEHOLD_ID=
MCP_ALLOWED_ORIGINS=
MCP_REQUEST_TIMEOUT=15s
MCP_MAX_CONCURRENT=4
MCP_REQUESTS_PER_MINUTE=60
MCP_MAX_BODY_BYTES=262144

# LLM modes: disabled, local, external.
# external: HTTPS OpenAI-compatible provider/gateway; API key and all model IDs are required.
LLM_MODE=external
LLM_BASE_URL=https://llm-gateway.example.com/v1
LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY
LLM_FAST_MODEL=REPLACE_WITH_CURRENT_FAST_MODEL_ID
LLM_PLANNER_MODEL=REPLACE_WITH_CURRENT_PLANNER_MODEL_ID
LLM_REVIEWER_MODEL=REPLACE_WITH_CURRENT_REVIEWER_MODEL_ID
# local: OpenAI-compatible local/private model. API key may be blank. Use TLS when the
# model host is another machine (for example a P40 box on the LAN); plaintext HTTP is
# permitted only for an IP-literal loopback endpoint by the provider security boundary.
# LLM_MODE=local
# LLM_BASE_URL=https://p40-ai.example/v1
# LLM_API_KEY=
# LLM_FAST_MODEL=REPLACE_WITH_LOCAL_FAST_MODEL_ID
# LLM_PLANNER_MODEL=REPLACE_WITH_LOCAL_PLANNER_MODEL_ID
# LLM_REVIEWER_MODEL=REPLACE_WITH_LOCAL_REVIEWER_MODEL_ID

# Optional encrypted off-site backup. Leave these blank during initial application bootstrap.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
RESTIC_REST_USERNAME=
RESTIC_REST_PASSWORD_FILE=
BACKUP_RETENTION_DAYS=14
